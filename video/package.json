{
  "name": "remotion-video-lab",
  "version": "1.0.0",
  "description": "Remotion video generation, preview and rendering test project",
  "repository": {
    "type": "git",
    "url": "https://github.com/AureliusWu/Remotion.git",
    "directory": "video"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src effects && tsc --noEmit",
    "check:versions": "remotion versions",
    "check:environment": "node scripts/check-environment.mjs",
    "browser:ensure": "remotion browser ensure",
    "ffmpeg": "remotion ffmpeg",
    "ffprobe": "remotion ffprobe",
    "verify:environment": "node scripts/verify-composition.mjs EnvironmentTest --seconds=4 --fps=60 --frames=0,120,239",
    "render:environment": "remotion render EnvironmentTest out/environment-test.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=128k --concurrency=2",
    "verify:environment-export": "node scripts/verify-export.mjs out/environment-test.mp4 4 60",
    "verify:genai": "node scripts/verify-composition.mjs ChinaGenAiTimeline --seconds=60 --fps=60 --frames=180,1080,1740,2220,2820,3420,3599 --voiceover=china-genai/voiceover-manifest.json",
    "verify:poisson": "node scripts/verify-composition.mjs PoissonEncounters --seconds=180 --fps=60 --frames=600,2100,3300,4500,5700,6900,8100,9300,10500,10799 --voiceover=poisson-process/voiceover-manifest.json",
    "render:poisson": "remotion render PoissonEncounters out/poisson-process-1080p60.mp4 --codec=h264 --crf=19 --pixel-format=yuv420p --image-format=jpeg --jpeg-quality=92 --audio-codec=aac --audio-bitrate=192k --concurrency=4",
    "render:test": "remotion render SmokeTest out/smoke-test.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2",
    "still:test": "remotion still SmokeTest out/smoke-test.png --frame=90"
  },
  "allowScripts": {
    "esbuild": false
  }
}
