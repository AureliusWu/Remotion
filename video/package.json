{
  "name": "remotion-video-lab",
  "version": "1.0.0",
  "description": "Remotion video generation, preview and rendering test project",
  "repository": {
    "type": "git",
    "url": "https://github.com/AureliusWu/Remotion.git",
    "directory": "video"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "workflow": "node scripts/workflow.mjs",
    "test:workflow": "node --test scripts/tests/*.test.mjs",
    "audio:ai-weekly": "out/ai-history-tts/venv/Scripts/python.exe scripts/generate-ai-weekly-audio.py",
    "verify:ai-weekly-content": "node scripts/verify-news-edition.mjs ai-weekly",
    "verify:ai-weekly-bilibili": "node scripts/verify-composition.mjs AiWeekly-Bilibili --seconds=180 --fps=60 --frames=210,840,1320,1920,2400,3000,3480,4080,4560,5160,5640,6240,6720,7320,7800,8400,8880,9420,9900,10410,10799 --voiceover=ai-weekly/voiceover-manifest.json",
    "verify:ai-weekly-douyin": "node scripts/verify-composition.mjs AiWeekly-Douyin --seconds=180 --fps=60 --width=1080 --height=1920 --frames=210,840,1320,1920,2400,3000,3480,4080,4560,5160,5640,6240,6720,7320,7800,8400,8880,9420,9900,10410,10799 --voiceover=ai-weekly/voiceover-manifest.json",
    "render:ai-weekly": "node scripts/render-ai-weekly.mjs",
    "verify:weekly-ten-content": "node scripts/verify-news-edition.mjs weekly-ten",
    "verify:weekly-ten-bilibili": "node scripts/verify-composition.mjs WeeklyTen-Bilibili --seconds=180 --fps=60 --frames=210,840,1260,1800,2220,2760,3180,3720,4140,4680,5100,5640,6060,6600,7020,7560,7980,8520,8940,9480,9900,10410,10799 --voiceover=weekly-ten/voiceover-manifest.json",
    "verify:weekly-ten-douyin": "node scripts/verify-composition.mjs WeeklyTen-Douyin --seconds=180 --fps=60 --width=1080 --height=1920 --frames=210,840,1260,1800,2220,2760,3180,3720,4140,4680,5100,5640,6060,6600,7020,7560,7980,8520,8940,9480,9900,10410,10799 --voiceover=weekly-ten/voiceover-manifest.json",
    "render:weekly-ten": "node scripts/render-weekly-ten.mjs",
    "verify:daily-ten-bilibili": "node scripts/verify-composition.mjs DailyTen-Bilibili --seconds=180 --fps=60 --frames=210,840,5640,7980,10799 --voiceover=daily-ten/voiceover-manifest.json",
    "verify:daily-ten-douyin": "node scripts/verify-composition.mjs DailyTen-Douyin --seconds=180 --fps=60 --width=1080 --height=1920 --frames=210,840,1260,1800,2220,2760,3180,3720,4140,4680,5100,5640,6060,6600,7020,7560,7980,8520,8940,9480,9900,10410,10799 --voiceover=daily-ten/voiceover-manifest.json",
    "verify:daily-ten-content": "node scripts/verify-daily-ten.mjs",
    "verify:daily-ten": "node scripts/verify-composition.mjs DailyTen20261030 --seconds=180 --fps=60 --frames=210,840,1260,1800,2220,2760,3180,3720,4140,4680,5100,5640,6060,6600,7020,7560,7980,8520,8940,9480,9900,10410,10799 --voiceover=daily-ten/voiceover-manifest.json",
    "audio:daily-ten": "out/ai-history-tts/venv/Scripts/python.exe scripts/generate-hotspot-audio.py effects/daily-ten/storyboard.json --speed=1.03",
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src effects && tsc --noEmit",
    "check:versions": "remotion versions",
    "check:environment": "node scripts/check-environment.mjs",
    "browser:ensure": "remotion browser ensure",
    "ffmpeg": "remotion ffmpeg",
    "ffprobe": "remotion ffprobe",
    "verify:environment": "node scripts/verify-composition.mjs EnvironmentTest --seconds=4 --fps=60 --frames=0,120,239",
    "render:environment": "remotion render EnvironmentTest out/environment-test.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=128k --concurrency=2",
    "verify:environment-export": "node scripts/verify-export.mjs out/environment-test.mp4 4 60",
    "prepare:ai-history": "node scripts/prepare-ai-history.mjs assemble",
    "produce:ai-history": "node scripts/produce-ai-history.mjs",
    "render:ai-history": "node scripts/render-ai-history.mjs",
    "audio:ai-history": "node scripts/build-ai-history-audio.mjs",
    "music:ai-history": "node scripts/build-ai-history-audio.mjs --music-only",
    "verify:ai-history": "node scripts/verify-composition.mjs AiHistory30m --seconds=1800 --fps=60 --frames=900,8100,15300,22500,29700,36900,44100,51300,58500,65700,72900,80100,87300,94500,101700,107999",
    "verify:ai-history-export": "node scripts/verify-export.mjs out/ai-history-1080p60.mp4 1800 60",
    "verify:ai-history-content": "node scripts/verify-ai-history.mjs",
    "verify:ai-history-audio": "node scripts/verify-ai-history.mjs --export=out/ai-history-1080p60.mp4",
    "verify:genai": "node scripts/verify-composition.mjs ChinaGenAiTimeline --seconds=60 --fps=60 --frames=180,1080,1740,2220,2820,3420,3599 --voiceover=china-genai/voiceover-manifest.json",
    "verify:poisson": "node scripts/verify-composition.mjs PoissonEncounters --seconds=180 --fps=60 --frames=600,2100,3300,4500,5700,6900,8100,9300,10500,10799 --voiceover=poisson-process/voiceover-manifest.json",
    "render:poisson": "remotion render PoissonEncounters out/poisson-process-1080p60.mp4 --codec=h264 --crf=19 --pixel-format=yuv420p --image-format=jpeg --jpeg-quality=92 --audio-codec=aac --audio-bitrate=192k --concurrency=4",
    "render:test": "remotion render SmokeTest out/smoke-test.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2",
    "still:test": "remotion still SmokeTest out/smoke-test.png --frame=90"
  },
  "allowScripts": {
    "esbuild": false
  }
}
