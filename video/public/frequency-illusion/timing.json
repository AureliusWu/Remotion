{
  "durationSeconds": 180.0,
  "storyboardSha256": "b9d975d5774c720d6a5c8d5865f04aed341b483ac1611537bdb72d830b993225",
  "audioSha256": "0176ac8888a1e8c5ba0190dae40196055964166a64e2475dbc9690e827a9f23a",
  "voice": "Kokoro 82M v1.1 Mandarin",
  "sampleRate": 24000,
  "speakerId": 3,
  "modelSha256": "05d793700b0b507f760c183c0e39bdd6a97b43d32fdc7bf7b54a5179f1b11222",
  "scenes": [
    {
      "title": "红伞怎么突然多了？",
      "speed": 1.03,
      "tempo": 1.0,
      "cues": [
        {
          "text": "昨天，你刚买了一把红伞。",
          "startMs": 400,
          "endMs": 2757
        },
        {
          "text": "今天下班，雨刚落下来，你已经瞥见了第三把。",
          "startMs": 2867,
          "endMs": 7157
        },
        {
          "text": "以前走这条路，怎么就没留意过？",
          "startMs": 7267,
          "endMs": 10512
        },
        {
          "text": "你忍不住想，红伞最近是不是变多了？",
          "startMs": 10622,
          "endMs": 14242
        }
      ]
    },
    {
      "title": "再看一遍这条街",
      "speed": 1.03,
      "tempo": 1.0,
      "cues": [
        {
          "text": "我们把同一张街景放两遍。",
          "startMs": 400,
          "endMs": 2942
        },
        {
          "text": "第一遍，你只管往前看，像平时下班一样。",
          "startMs": 3052,
          "endMs": 7052
        },
        {
          "text": "第二遍，特意找找画面里的红伞。",
          "startMs": 7162,
          "endMs": 9975
        },
        {
          "text": "街上连一把伞都没添，你留意到的细节却多了。",
          "startMs": 10085,
          "endMs": 14384
        }
      ]
    },
    {
      "title": "频率错觉",
      "speed": 1.1407,
      "tempo": 1.107495,
      "cues": [
        {
          "text": "二零零五年，语言学家兹威基写到一种现象。",
          "startMs": 400,
          "endMs": 4235
        },
        {
          "text": "刚留意到某种用法，就觉得它好像到处都有。",
          "startMs": 4345,
          "endMs": 8204
        },
        {
          "text": "他把这种感受叫作频率错觉。",
          "startMs": 8314,
          "endMs": 10886
        },
        {
          "text": "熟悉的事物，也可能是我们最近才注意到。",
          "startMs": 10996,
          "endMs": 14543
        }
      ]
    },
    {
      "title": "眼睛先去找红伞",
      "speed": 1.1189,
      "tempo": 1.086334,
      "cues": [
        {
          "text": "当你在找红伞，眼睛扫过街面，会先留意红色。",
          "startMs": 400,
          "endMs": 4738
        },
        {
          "text": "蓝伞和黑伞还在，只是没那么引人注意。",
          "startMs": 4848,
          "endMs": 8371
        },
        {
          "text": "这就是选择性注意。",
          "startMs": 8481,
          "endMs": 10355
        },
        {
          "text": "每个人走过同一个路口，也可能看到不同细节。",
          "startMs": 10465,
          "endMs": 14555
        }
      ]
    },
    {
      "title": "数传球时，谁走过了？",
      "speed": 1.1311,
      "tempo": 1.09814,
      "cues": [
        {
          "text": "一九九九年，有个实验请观众数一队传球。",
          "startMs": 400,
          "endMs": 4238
        },
        {
          "text": "一个穿猩猩服的人从画面里走过。",
          "startMs": 4348,
          "endMs": 7193
        },
        {
          "text": "有些观众专心数球，没注意到他。",
          "startMs": 7303,
          "endMs": 10375
        },
        {
          "text": "这个实验说明，注意的去向会影响我们看见什么。",
          "startMs": 10485,
          "endMs": 14551
        }
      ]
    },
    {
      "title": "一次撞见，一次佐证",
      "speed": 1.1121,
      "tempo": 1.079717,
      "cues": [
        {
          "text": "等你开始相信红伞变多，每撞见一把，就会想，果然。",
          "startMs": 400,
          "endMs": 5255
        },
        {
          "text": "走完一条街都没看见的时候，却很少特意记下。",
          "startMs": 5365,
          "endMs": 9639
        },
        {
          "text": "我们可能更在意支持自己猜测的证据。",
          "startMs": 9749,
          "endMs": 12956
        },
        {
          "text": "这叫确认偏误。",
          "startMs": 13066,
          "endMs": 14555
        }
      ]
    },
    {
      "title": "两个猜法，都能答对吗？",
      "speed": 1.0838,
      "tempo": 1.05223,
      "cues": [
        {
          "text": "一项猜规则的实验，从二、四、六开始。",
          "startMs": 400,
          "endMs": 3832
        },
        {
          "text": "你也许会猜，每次加二。",
          "startMs": 3942,
          "endMs": 6312
        },
        {
          "text": "试八、十、十二，确实能过。可一、三、八也能过。",
          "startMs": 6422,
          "endMs": 10625
        },
        {
          "text": "真正的规则简单得多，三个数从小到大。",
          "startMs": 10735,
          "endMs": 14532
        }
      ]
    },
    {
      "title": "有时是推送变了",
      "speed": 1.1137,
      "tempo": 1.081238,
      "cues": [
        {
          "text": "刷视频时，情况还多一层。",
          "startMs": 400,
          "endMs": 2781
        },
        {
          "text": "你多看了几条雨伞测评，平台可能接着推荐类似视频。",
          "startMs": 2891,
          "endMs": 7681
        },
        {
          "text": "这时，你屏幕上的雨伞内容可能真的多了。",
          "startMs": 7791,
          "endMs": 11073
        },
        {
          "text": "至于全站有没有变，还得找另外的证据。",
          "startMs": 11183,
          "endMs": 14542
        }
      ]
    },
    {
      "title": "街上也可能真的变了",
      "speed": 1.1039,
      "tempo": 1.071779,
      "cues": [
        {
          "text": "回到街上，雨要是下大了，撑伞的人可能真的多起来。",
          "startMs": 400,
          "endMs": 4953
        },
        {
          "text": "也可能有更多红伞出现在这个路口。",
          "startMs": 5063,
          "endMs": 8168
        },
        {
          "text": "你的注意变了，街上的情况也可能在变。",
          "startMs": 8278,
          "endMs": 11725
        },
        {
          "text": "那就看看，数出来的结果是什么。",
          "startMs": 11835,
          "endMs": 14553
        }
      ]
    },
    {
      "title": "先看分母",
      "speed": 1.03,
      "tempo": 1.0,
      "cues": [
        {
          "text": "举个例子，昨天二十把伞里有两把红伞。",
          "startMs": 400,
          "endMs": 3741
        },
        {
          "text": "今天四十把里有四把。",
          "startMs": 3851,
          "endMs": 5980
        },
        {
          "text": "红伞的数量翻倍了，占比却都是百分之十。",
          "startMs": 6090,
          "endMs": 10207
        },
        {
          "text": "你说的变多，指的是把数，还是比例？",
          "startMs": 10317,
          "endMs": 14105
        }
      ]
    },
    {
      "title": "先定规则，再数",
      "speed": 1.0613,
      "tempo": 1.030427,
      "cues": [
        {
          "text": "想弄清楚，可以先选定同一个路口。",
          "startMs": 400,
          "endMs": 3500
        },
        {
          "text": "几天都挑同一个时段，站十分钟。",
          "startMs": 3610,
          "endMs": 6830
        },
        {
          "text": "记下经过的红伞，也记下经过的所有伞。",
          "startMs": 6940,
          "endMs": 10647
        },
        {
          "text": "遇上没红伞的一天，照样在表上写个零。",
          "startMs": 10757,
          "endMs": 14522
        }
      ]
    },
    {
      "title": "再看一眼",
      "speed": 1.03,
      "tempo": 1.0,
      "cues": [
        {
          "text": "刚才光顾着数伞，漏看了一件事。",
          "startMs": 400,
          "endMs": 3755
        },
        {
          "text": "红灯下，有人把伞往同伴那边挪了挪。",
          "startMs": 3865,
          "endMs": 7042
        },
        {
          "text": "看人也一样，第一眼会漏看。",
          "startMs": 7152,
          "endMs": 10030
        },
        {
          "text": "再看一眼，或许能看见印象之外的人。",
          "startMs": 10140,
          "endMs": 13255
        }
      ]
    }
  ]
}
